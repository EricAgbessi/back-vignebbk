# =====================================================
# STAGE 1 — BUILD
# =====================================================
FROM node:22-alpine AS builder

WORKDIR /usr/src/app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json prisma.config.ts ./
COPY prisma ./prisma
COPY src ./src

# Generate Prisma client and compile TypeScript.
# The dummy DATABASE_URL satisfies prisma.config.ts at build time; the real
# value is injected at runtime via docker-compose env.
RUN DATABASE_URL="mysql://build:build@localhost:3306/build" npx prisma generate
RUN npm run build

# Strip dev dependencies for the runtime image.
RUN npm prune --omit=dev

# =====================================================
# STAGE 2 — RUNTIME
# =====================================================
FROM node:22-alpine AS runner

ENV NODE_ENV=production
ENV PORT=8080

WORKDIR /usr/src/app

# Run as a non-root user.
RUN addgroup -S app && adduser -S app -G app

COPY --from=builder --chown=app:app /usr/src/app/node_modules ./node_modules
COPY --from=builder --chown=app:app /usr/src/app/dist ./dist
COPY --from=builder --chown=app:app /usr/src/app/prisma ./prisma
COPY --from=builder --chown=app:app /usr/src/app/package.json ./package.json

# uploads/ is mounted as a volume in production.
RUN mkdir -p /usr/src/app/uploads && chown -R app:app /usr/src/app/uploads

USER app

EXPOSE 8080

CMD ["node", "dist/index.js"]
